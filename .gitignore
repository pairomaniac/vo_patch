# PyInstaller writes both of these next to the spec.
build/
dist/

__pycache__/
*.pyc

# Backups the patcher makes beside the game.
*.bak
*.ini.patched

# layout.py writes these when run on its own; build.py uses a temp directory.
asm/strings.inc
asm/*.bin

# net/build.py bakes the DLL into vo-patch.py; the file itself is scratch.
net/dpctrl.dll
vo-net.log

# vo-loopback.sh reads its paths from here; they are machine specific.
.vo-loopback
