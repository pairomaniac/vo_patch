# PyInstaller writes both of these next to the spec.
build/
dist/

__pycache__/
*.pyc

# Backups the patcher makes beside the game.
*.bak
*.ini.patched

# layout.py writes these when run on its own; build.py uses a temp directory.
asm/strings.inc
asm/*.bin

# net/build.py bakes the DLL into vo_patch.py; the file itself is scratch.
net/dpctrl.dll
vo-net.log

# tools/setup-dev.sh makes the venv; the tooling lives there, never in git.
.venv/

# tools/maps.sh writes the vomap maps and port tables here, from the game
# executables, which are not in the repository either.
maps/*
!maps/README.md
